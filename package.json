    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "^2.0.6",
    "bcrypt": "^6.0.0",
    "better-auth": "^1.6.1",
    "better-sqlite3": "^12.8.0",
    "bufferutil": "^4.1.0",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
